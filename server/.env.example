# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
# Local: mongodb://127.0.0.1:27017/jobseeker
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobseeker?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/jobseeker

# JWT
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Uploads
MAX_RESUME_MB=5
MAX_LOGO_MB=2

# Admin bootstrap (used only by `npm run create-admin` / seed)
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@jobseeker.in
ADMIN_PASSWORD=ChangeMe@12345
ADMIN_PHONE=9999999999
